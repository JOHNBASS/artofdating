---
interface Props {
  id: string;
  rows: { left: string; right: string }[];
  steps?: number;
}

const { id, rows, steps = 7 } = Astro.props;
const mid = Math.ceil(steps / 2);
---

<div class="spectrum">
  {
    rows.map((r, i) => (
      <div class="spectrum-row">
        <div class="ends" aria-hidden="true">
          <span>{r.left}</span>
          <output>—</output>
          <span>{r.right}</span>
        </div>
        <input
          type="range"
          min="1"
          max={steps}
          step="1"
          value={mid}
          aria-label={`${r.left} 到 ${r.right}`}
          data-save={`${id}:${i}`}
          data-label={`${r.left}|${r.right}`}
        />
      </div>
    ))
  }
  <p class="hint muted small">拖曳圓點，靠近哪一邊就代表你比較像哪一邊。沒有好壞，只有不同。</p>
</div>

<style>
  .spectrum {
    margin: 0 0 1em;
  }
  .spectrum-row {
    padding: 0.55em 0;
    border-bottom: 1px dashed var(--line);
  }
  .ends {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 8px;
    font-size: 0.95rem;
  }
  .ends span:last-child {
    text-align: right;
  }
  output {
    color: var(--ink-soft);
    font-size: 0.8rem;
    min-width: 2ch;
    text-align: center;
  }
  input[type='range'] {
    width: 100%;
    accent-color: var(--accent);
    height: 32px;
    margin: 0;
  }
  .hint {
    margin-top: 0.6em;
  }
</style>
