---
interface Props {
  id: string;
  items: string[];
  max?: number;
  label?: string;
}

const { id, items, max, label } = Astro.props;
---

<div class="chips" data-chips data-max={max}>
  {
    label && (
      <p class="chips-label">
        {label} <span class="count" data-chip-count />
      </p>
    )
  }
  <div class="list">
    {
      items.map((item, i) => (
        <label>
          <input type="checkbox" data-save={`${id}:${i}`} data-label={item} />
          <span>{item}</span>
        </label>
      ))
    }
  </div>
</div>

<style>
  .chips {
    margin: 0 0 1.1em;
  }
  .chips-label {
    font-weight: 500;
    margin-bottom: 0.5em;
  }
  .count {
    color: var(--ink-soft);
    font-weight: 400;
    font-size: 0.9em;
    margin-left: 0.4em;
  }
  .list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  label {
    position: relative;
    cursor: pointer;
  }
  input {
    position: absolute;
    opacity: 0;
    inset: 0;
    cursor: pointer;
  }
  span {
    display: inline-block;
    padding: 0.35em 0.9em;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg);
    font-size: 0.95rem;
    transition: background 0.15s, border-color 0.15s;
  }
  input:checked + span {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--surface);
  }
  input:focus-visible + span {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  input:disabled + span {
    opacity: 0.45;
  }
</style>
