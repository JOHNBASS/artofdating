---
import Base from './Base.astro';
import { sessions, modes } from '../data/sessions.js';
import { url } from '../scripts/paths.js';

const { frontmatter } = Astro.props;
const num = Number(frontmatter.num);
const s = sessions.find((x) => x.num === num);
const prev = sessions.find((x) => x.num === num - 1);
const next = sessions.find((x) => x.num === num + 1);
---

<Base title={`第 ${num} 堂・${s.title}`} description={s.summary}>
  <div data-notes-page={`s${num}`}>
    <section class="hero">
      <div class="wrap">
        <p class="eyebrow">第 {num} 堂 · {s.theme}</p>
        <h1 data-session-title>{s.title}</h1>
        <p class="tagline">{s.tagline}</p>
        <p class="summary">{s.summary}</p>
        <ul class="legend" aria-label="練習方式">
          {
            Object.entries(modes).map(([k, m]) => (
              <li class={`m-${k}`}>
                <span aria-hidden="true">{m.icon}</span>
                <strong>{m.label}</strong>
                <span class="muted">{m.desc}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <nav class="session-tabs wrap" aria-label="五堂課" data-session-tabs>
      {
        sessions.map((x) => (
          <a href={url(`sessions/${x.num}/`)} aria-current={x.num === num ? 'page' : undefined}>
            <span class="n">{x.num}</span>
            <span class="t">{x.title}</span>
          </a>
        ))
      }
    </nav>

    <article class="wrap content">
      <slot />
    </article>

    <div class="wrap">
      <section class="toolbar" id="notes" aria-labelledby="notes-title" data-notes-panel>
        <div class="intro">
          <h2 id="notes-title">保存我的筆記</h2>
          <p class="muted small">
            你填寫的內容會自動存在這台裝置的瀏覽器裡。但手機瀏覽器可能會清掉太久沒開的網站資料，每堂課結束前，記得另外保存一份。
          </p>
        </div>
        <div class="actions">
          <button type="button" class="btn-primary" data-share hidden>傳給自己保存</button>
          <button type="button" data-copy>複製全部文字</button>
          <button type="button" data-export>下載文字檔</button>
          <button type="button" class="clear" data-clear>清除這一堂</button>
        </div>
        <p class="muted small tip" data-share-tip>「傳給自己保存」會打開手機的分享選單，可以存到 LINE Keep、備忘錄，或寄 Email 給自己。</p>
      </section>

      <nav class="pager" aria-label="上一堂與下一堂">
        {
          prev ? (
            <a href={url(`sessions/${prev.num}/`)} class="prev">
              <span class="muted small">← 上一堂</span>
              {prev.title}
            </a>
          ) : (
            <a href={url('')} class="prev">
              <span class="muted small">← 回到</span>
              課程介紹
            </a>
          )
        }
        {
          next ? (
            <a href={url(`sessions/${next.num}/`)} class="next">
              <span class="muted small">下一堂 →</span>
              {next.title}
            </a>
          ) : (
            <a href={url('')} class="next">
              <span class="muted small">完成了 →</span>
              回到課程介紹
            </a>
          )
        }
      </nav>
    </div>
    <a class="notes-fab" href="#notes" data-notes-fab>
      <span aria-hidden="true">✎</span> 保存筆記
    </a>
    <p class="save-status" data-save-status role="status"></p>
  </div>
</Base>

<script>
  import '../scripts/notes.js';
</script>

<style>
  .hero {
    background:
      radial-gradient(1200px 400px at 85% -10%, var(--gold-soft), transparent 60%),
      radial-gradient(900px 400px at -10% 0%, var(--accent-soft), transparent 60%);
    padding: 2.5em 0 1.5em;
  }
  .eyebrow {
    color: var(--accent);
    font-weight: 700;
    letter-spacing: 0.12em;
    margin: 0;
  }
  h1 {
    margin: 0.15em 0 0.1em;
  }
  .tagline {
    font-family: var(--serif);
    font-size: 1.2rem;
    color: var(--ink-soft);
  }
  .summary {
    max-width: 36em;
  }
  .legend {
    list-style: none;
    padding: 0;
    margin: 1.2em 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    font-size: 0.88rem;
  }
  .legend li {
    display: flex;
    gap: 0.4em;
    align-items: baseline;
  }
  .m-self strong,
  .m-self span:first-child {
    color: var(--self);
  }
  .m-pair strong,
  .m-pair span:first-child {
    color: var(--pair);
  }
  .m-table strong,
  .m-table span:first-child {
    color: var(--table);
  }
  .session-tabs {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    padding-top: 14px;
    padding-bottom: 6px;
    scrollbar-width: none;
  }
  .session-tabs a {
    flex: none;
    display: flex;
    align-items: center;
    gap: 0.45em;
    text-decoration: none;
    color: var(--ink-soft);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.3em 0.85em 0.3em 0.35em;
    font-size: 0.9rem;
    background: var(--surface);
  }
  .session-tabs .n {
    display: inline-grid;
    place-items: center;
    width: 1.7em;
    height: 1.7em;
    border-radius: 50%;
    background: var(--surface-2);
    font-weight: 700;
    font-size: 0.85em;
  }
  .session-tabs a[aria-current='page'] {
    color: var(--accent);
    border-color: var(--accent);
  }
  .session-tabs a[aria-current='page'] .n {
    background: var(--accent);
    color: var(--surface);
  }
  .content {
    padding-top: 0.5em;
  }
  .toolbar {
    margin-top: 3em;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 12px 20px;
    align-items: center;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .toolbar h2 {
    font-size: 1.15rem;
    margin: 0;
  }
  .toolbar p {
    margin: 0.2em 0 0;
  }
  .toolbar .tip {
    grid-column: 1 / -1;
    margin: 0;
  }
  .actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  .actions .btn-primary {
    order: -1;
  }
  .actions :global(.danger) {
    border-color: var(--accent);
    color: var(--accent);
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 1.5em;
  }
  .pager a {
    display: flex;
    flex-direction: column;
    padding: 14px 16px;
    border-radius: var(--radius);
    background: var(--surface-2);
    color: var(--ink);
    text-decoration: none;
    font-family: var(--serif);
    font-weight: 700;
  }
  .pager .next {
    text-align: right;
  }
  .save-status {
    position: fixed;
    left: 50%;
    top: 70px;
    z-index: 6;
    max-width: calc(100% - 32px);
    transform: translate(-50%, -10px);
    background: var(--ink);
    color: var(--bg);
    padding: 0.4em 1em;
    border-radius: 999px;
    font-size: 0.85rem;
    text-align: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s, transform 0.2s;
    margin: 0;
  }
  .save-status:global(.on) {
    opacity: 0.94;
    transform: translate(-50%, 0);
  }
  .notes-fab {
    display: none;
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: 1.6em;
    }
    .tagline {
      font-size: 1.1rem;
    }
    .legend {
      flex-direction: column;
      gap: 2px;
    }
    .session-tabs {
      scroll-snap-type: x proximity;
      scroll-padding-inline: 16px;
      position: relative;
      -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 28px), transparent);
      mask-image: linear-gradient(to right, #000 calc(100% - 28px), transparent);
    }
    .session-tabs a {
      scroll-snap-align: start;
      min-height: 40px;
    }
    .toolbar {
      grid-template-columns: 1fr;
      padding: 16px;
    }
    .actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .actions button {
      justify-content: center;
    }
    .actions .btn-primary {
      grid-column: 1 / -1;
      min-height: 50px;
      font-size: 1rem;
    }
    .actions .clear {
      grid-column: 1 / -1;
      background: transparent;
      border-style: dashed;
    }
    .pager a {
      padding: 12px 14px;
      font-size: 0.95rem;
    }
    .notes-fab {
      display: inline-flex;
      align-items: center;
      gap: 0.4em;
      position: fixed;
      right: max(16px, env(safe-area-inset-right));
      bottom: calc(16px + env(safe-area-inset-bottom));
      z-index: 6;
      min-height: 44px;
      padding: 0 1.1em;
      border-radius: 999px;
      background: var(--accent);
      color: #fff;
      font-weight: 500;
      font-size: 0.95rem;
      text-decoration: none;
      box-shadow: 0 6px 20px rgba(43, 32, 36, 0.25);
      opacity: 0;
      transform: translateY(12px);
      pointer-events: none;
      transition: opacity 0.2s, transform 0.2s;
    }
    .notes-fab:global(.on) {
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }
  }
  @media (max-width: 640px) and (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .notes-fab {
      color: #1b1416;
    }
  }
  :global(:root[data-theme='dark']) .notes-fab {
    color: #1b1416;
  }
  @media (prefers-reduced-motion: reduce) {
    .notes-fab,
    .save-status {
      transition: none;
    }
  }
</style>
