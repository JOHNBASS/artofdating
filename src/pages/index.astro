---
import Landing from '../layouts/Landing.astro';
import { sessions } from '../data/sessions.js';
import { worries } from '../data/worries.js';
import WorryChart from '../components/WorryChart.astro';
import { url } from '../scripts/paths.js';

const img = (f: string) => url(`assets/img/${f}`);
const mainAction = '看五堂課';
const srcset = (name: string, ws: number[]) => ws.map((w) => `${img(`${name}-${w}.jpg`)} ${w}w`).join(', ');

// word-highlight 以空白切字；中文沒有空白，所以先把句子切成詞組，每組一個 span
const statement: (string | { strong: string })[] = [
  '愛情', '不會因為', '結婚', '就死掉；', '讓它', '慢慢消失的，', '是', '兩個人', '不再', '一起練習。',
  '好好聆聽、', '好好吵架、', '好好做決定，', '這些', '都', { strong: '學得會' }, '。',
];

// 每晚流程：pinned-chapters 三段，捲動時依序展開，右邊照片跟著換
const evening = [
  { time: '18:45', title: '18:45　入場、破冰，一起吃晚餐', desc: '找到你的桌組，從輕鬆的小遊戲開始。同桌 4 到 6 人，五週都坐同一桌。', img: 'ai-e1-dinner', alt: '燭光長桌上，大家正把台菜一盤盤傳過去' },
  { time: '19:30', title: '19:30　三段主題：短講加練習', desc: '每段一個短講，接著自己寫、兩人聊或同桌聊。任何問題，你都可以說 pass。', img: 'ai-e2-practice', alt: '兩個人在燭光小桌兩側對坐，一人拿著一張題目卡' },
  { time: '21:00', title: '21:00　帶一個約會實驗回家', desc: '每週一個小任務，在生活裡試試看。想多聊可以留下，想早點回家也沒問題。', img: 'ai-e3-home', alt: '夜裡在家門口，一隻手把摺好的小卡片放進大衣口袋' },
];

// 五堂課：滑過或點一堂，右邊換成那一堂的照片（peek-list）
const sessionImgs = {
  1: { img: 'ai-s1-listen', alt: '咖啡館小桌兩側，一人雙手捧著杯子，另一人傾身傾聽' },
  2: { img: 'ai-s2-repair', alt: '吵完架的餐桌上，一隻手輕輕伸向對方攤開的手' },
  3: { img: 'ai-s3-choose', alt: '一隻手把一把黃銅鑰匙放進另一個人的掌心' },
  4: { img: 'ai-s4-share', alt: '晚餐桌上，好幾雙手把菜傳給彼此' },
  5: { img: 'ai-s5-journey', alt: '兩個人並肩站在山徑上，看著黃昏的台北' },
};

// 結尾的關鍵字標籤
const keywords = ['聆聽', '好奇心約會', '吵架', '暫停暗號', '選擇', '我的清單', '靠近', '愛的語言', '冒險', '給三個月後的自己'];

const faqs = [
  { q: '我是單身，會不會很尷尬？', a: '不會。課程以單身者為主，練習可以自己做，或和當晚的夥伴一起做，不需要帶伴侶來。' },
  { q: '這是聯誼嗎？', a: '不是。我們不配對，也不安排約會；但你會認識一群認真看待關係的人。' },
  { q: '一定要分享自己的隱私嗎？', a: '不用。每個練習都標明是自己寫、兩人聊，還是同桌聊；私密的題目只自己寫，任何問題都可以說 pass。' },
  { q: '這是宗教課程嗎？', a: '不是。創辦人是基督徒，想聊信仰可以私下聊；課程以關係研究為基礎，不傳教，也不需要任何信仰背景。' },
  { q: '我已經在交往了，可以兩人一起來嗎？', a: '歡迎。兩人一起來時，「兩人」的練習就由你們彼此一組。' },
  { q: '我在網站上寫的內容，別人看得到嗎？', a: '看不到。內容只存在你自己的瀏覽器裡，不會上傳；可以傳給自己保存，也可以隨時清除。' },
  { q: '需要準備什麼？', a: '一支手機，用來打開這個網站做練習；或帶一支筆也可以。' },
];
---

<Landing
  title="關係練習室：給單身者的五晚關係課"
  description="五個晚上，一起吃晚餐，用關係研究和練習學會聆聽、吵架、做選擇和靠近。以單身者為主，情侶也歡迎。"
  moments={['word-rotate', 'lines-rise', 'counter-rolls', 'word-highlight', 'pinned-chapters', 'picture-develops']}
>
  <style is:inline slot="head">
    /* 頁面 CSS：只放視覺內部與套件沒有的部分 */
    .frame--square { aspect-ratio: 8 / 9; }
    .frame--land { aspect-ratio: 4 / 3; }
    .frame--square > img, .frame--land > img { width: 100%; height: 100%; object-fit: cover; display: block; }
    #worries .section-head { align-self: start; }
    .worry { display: flex; flex-direction: column; gap: var(--s-2); }
    .worry h3 { margin: 0; }
    .worry .stat { margin-top: var(--s-2); }
    .worry .stat .t-stat { margin-right: var(--s-1); }
    .worry p { margin: 0; }
    .worry .src { margin-top: auto; padding-top: var(--s-2); }
    .wchart { display: block; width: 100%; height: auto; margin-top: var(--s-3); overflow: visible; }
    .wchart text { font: 500 15px var(--font-text); fill: var(--muted); }
    .wchart .axis { stroke: var(--line, rgba(43,32,36,.15)); stroke-width: 1.5; }
    .wchart .line { fill: none; stroke: var(--ink); stroke-width: 3; stroke-linecap: round; }
    .wchart .mark { fill: var(--accent); }
    .wchart .dot, .wchart .track { fill: rgba(43, 32, 36, .12); }
    /* 小圖進場：曲線畫出來、點一顆顆亮起、長條伸長（只在捲到時跑一次；減少動態時直接顯示完成） */
    .wchart .line { stroke-dasharray: 420; stroke-dashoffset: 0; transition: stroke-dashoffset 1.4s cubic-bezier(.22, 1, .36, 1); }
    .wchart circle.mark, .wchart rect.mark { transform-box: fill-box; transform-origin: left center; transition: opacity .35s ease, transform .9s cubic-bezier(.22, 1, .36, 1); transition-delay: calc(var(--i, 0) * 16ms); }
    .wchart.wc-wait .line { stroke-dashoffset: 420; }
    .wchart.wc-wait circle.mark { opacity: 0; transform: scale(.3); }
    .wchart.wc-wait rect.mark { transform: scaleX(0); }
    .wchart circle.peak { transform-origin: center; transition-delay: 1.1s; }
    /* 1024 以上四張並排；平板兩欄；手機一欄 */
    @media (min-width: 640px) and (max-width: 1023px) { .worries > .span-3 { grid-column: span 6; } #worries .frame--land { aspect-ratio: 16 / 9; } }
    @media (max-width: 639px) { .worries > .span-3 { grid-column: 1 / -1; } }
    .rows__name small { display: block; font-weight: 400; color: var(--muted); font-size: var(--t-small); }
    /* 結尾大標題上方的關鍵字標籤 */
    footer.closing ul.keywords { list-style: none; margin: 0 0 var(--s-6); padding: 0; display: flex; flex-flow: row wrap; gap: var(--s-2); width: auto; }
    footer.closing ul.keywords > li { flex: none; width: auto; margin: 0; padding: 6px 14px; border: 1px solid color-mix(in srgb, var(--ink) 15%, transparent); border-radius: 999px; font-size: var(--t-small); color: var(--ink); transition: background-color .15s, border-color .15s, color .15s; }
    footer.closing ul.keywords > li:hover { background: var(--accent); border-color: var(--accent); color: var(--p-accent-ink); }
    /* 中文標題只在詞組之間換行（<wbr>），不會斷在詞的中間 */
    #hero-h, #close-h { word-break: keep-all; }
    /* 區塊高度依內容決定，不再固定成一屏或兩屏：矮的螢幕不會切字，高的螢幕不會留大片空白。
       英雄區至少一屏、放不下時自己長高；捲動定格的流程區由它自己的特效決定高度 */
    main > section.section:not([data-moment="pinned-chapters"]), footer.footer.closing { height: auto !important; min-height: 0 !important; }
    main > section.section.g2 > .wrap, footer.footer.closing > .wrap { display: flex !important; flex-direction: column; row-gap: var(--s-8) !important; }
    main > section.section.g2 > .wrap > *, footer.footer.closing > .wrap > * { margin-block: 0 !important; }
    main > section.hero { height: auto !important; min-height: 100svh; }
    @media (min-width: 640px) and (max-width: 1023px) { main > section.hero { min-height: 0; } }
  </style>

  <!-- type: service（五晚的關係工作坊，主辦是個人）
       deal: hero photo (data-calm left, 字在色塊裡), nav nav-centre, close close-type, footer footer-columns,
             rhythm dark-band (#evening), buttons tonal, mark arc, palette brand（課程頁原本的米白與酒紅）, type newsreader + Noto TC
       moments（應使用者要求加多）: word-rotate (hero h1), counter-rolls (#worries), word-highlight (#statement),
             lines-rise + peek-list (#sessions), pinned-chapters (#evening), picture-develops (#faq)；結尾關鍵字改成靜態標籤（跑馬燈會切到字）
       照片：全部由 AI 生成（Codex 圖像生成），之後可換成課程現場照（見 README） -->
  <header class="nav nav--centre">
    <div class="wrap nav__bar">
      <a class="skip-link" href="#top">跳到主要內容</a>
      <a class="nav__logo" href="#top"><span class="mark" data-mark="arc" aria-hidden="true"></span>關係練習室</a>
      <nav class="nav__links" aria-label="主選單">
        <div class="nav__item"><a class="nav__link" href="#worries">擔心</a></div>
        <div class="nav__item">
          <a class="nav__link" href="#sessions">五堂課 <svg class="chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></a>
          <div class="nav__menu">
            <div class="wrap grid">
              <div class="menu-col span-4">
                <p class="t-label">課程內容</p>
                {sessions.slice(0, 3).map((s) => (
                  <a href={url(`sessions/${s.num}/`)}>第 {s.num} 堂・{s.title}<span>{s.tagline}</span></a>
                ))}
              </div>
              <div class="menu-col span-4">
                <p class="t-label">&nbsp;</p>
                {sessions.slice(3).map((s) => (
                  <a href={url(`sessions/${s.num}/`)}>第 {s.num} 堂・{s.title}<span>{s.tagline}</span></a>
                ))}
              </div>
            </div>
          </div>
        </div>
        <div class="nav__item"><a class="nav__link" href="#evening">流程</a></div>
        <div class="nav__item"><a class="nav__link" href="#faq">問答</a></div>
      </nav>
      <div class="nav__actions">
        <a class="btn btn--primary" href="#sessions">{mainAction}</a>
      </div>
      <button class="nav__toggle" type="button" aria-expanded="false" aria-label="選單">
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 5h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
      </button>
    </div>
  </header>

  <main id="top">
    <section class="hero hero--photo" data-enter data-calm="left" aria-labelledby="hero-h">
      <img
        class="hero__bg"
        src={img('ai-hero-1280.jpg')}
        srcset={srcset('ai-hero', [960, 1280, 1672])}
        sizes="(max-width: 639px) 189vw, 100vw"
        width="1672"
        height="941"
        alt="傍晚的台北，燭光長桌已經擺好餐盤，窗外看得到台北 101"
        style="--ly-pos: 60% 60%; --ly-pos-phone: 64% 62%"
        fetchpriority="high"
        decoding="async"
        data-source="client"
        data-subject="scene"
      />
      <div class="wrap"><div class="hero-text">
        <div class="hero__text">
          <h1 id="hero-h">給<span data-moment="word-rotate" data-moment-opts='{"words": ["單身", "情侶"], "every": 2400}'>單身</span>的<wbr />五晚<wbr />關係課</h1>
          <p class="hero__lead">五個晚上，每晚 18:45 到 21:15。先一起吃晚餐，再用練習學會聆聽、吵架、做選擇和靠近。內容以關係研究為基礎，單身來就好，情侶也歡迎。</p>
          <div class="btn-row">
            <a class="btn btn--primary" href="#sessions">{mainAction}<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"></path><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"></path></svg></a>
            <a class="btn btn--secondary" href={url('sessions/1/')}>開始第一堂</a>
          </div>
        </div>
      </div></div>
    </section>

    <section class="section g2" id="worries" aria-labelledby="worries-h">
      <div class="wrap">
        <div class="group">
          <div class="grid">
            <div class="section-head span-5">
              <h2 id="worries-h">關於愛情的四個擔心。<span class="muted">先看數字，再談能做什麼。</span></h2>
              <p class="t-lead">怕受傷、怕失去自由、怕看錯人，這些擔心都很真實。我們把最常聽到的四個整理出來，附上可以查證的資料。</p>
              <p><a class="link" href={url('sources/')}>看完整資料來源</a></p>
            </div>
            <div class="frame frame--photo frame--land span-6 start-7">
              <img
                class="frame__img"
                src={img('ai-worries-1280.jpg')}
                srcset={srcset('ai-worries', [640, 1280])}
                sizes="(max-width: 1023px) 100vw, 50vw"
                width="1280"
                height="720"
                alt="檯燈下的木桌上，一本攤開的筆記本、一支筆和一杯茶"
                loading="lazy"
                decoding="async"
                data-source="client"
                data-subject="scene"
              />
            </div>
          </div>
        </div>
        <div class="grid worries" data-moment="counter-rolls">
          {
            worries.map((w) => (
              <article class="card worry m-nolift span-3">
                <h3>{w.q}</h3>
                <WorryChart chart={w.chart} />
                <p class="stat"><span class="t-stat">{w.stat}</span> <span class="t-small">{w.statLabel}</span></p>
                <p>{w.a}</p>
                <p class="t-small muted src">資料：{w.src}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section statement" id="statement" data-moment="word-highlight" aria-label="我們相信的事">
      <div class="wrap">
        <p class="t-label">我們相信的事</p>
        <p class="mo-wh__text">
          {statement.map((w) => (typeof w === 'string' ? <span>{w}</span> : <strong><span>{w.strong}</span></strong>))}
        </p>
      </div>
    </section>

    <section class="section" id="sessions" data-moment="lines-rise" aria-labelledby="sessions-h">
      <div class="wrap">
        <div class="grid" data-peek>
          <div class="span-5 stack-5">
            <div class="section-head">
              <h2 id="sessions-h">五個晚上的五堂課</h2>
              <p>每堂有短講、練習，和一個帶回家的約會實驗。滑過或點一堂看看，點標題就是當晚的上課內容。</p>
            </div>
            <ul class="rows">
              {
                sessions.map((s) => (
                  <li data-peek-to={`s${s.num}`} tabindex="0">
                    <span class="rows__name">
                      <a class="link" href={url(`sessions/${s.num}/`)}>第 {s.num} 堂・{s.title}</a>
                      <small>{s.tagline}</small>
                    </span>
                    <span class="rows__value">{s.theme}</span>
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="frame frame--photo frame--square span-6 start-7 mo-lr__follow">
            {
              sessions.map((s, i) => (
                <img
                  class="frame__img"
                  data-peek-for={`s${s.num}`}
                  src={img(`${sessionImgs[s.num].img}-1024.jpg`)}
                  srcset={srcset(sessionImgs[s.num].img, [600, 1024])}
                  sizes="(max-width: 1023px) 100vw, 50vw"
                  width="1024"
                  height="1536"
                  alt={sessionImgs[s.num].alt}
                  hidden={i > 0}
                  decoding="async"
                  data-source="client"
                  data-subject="scene"
                />
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="section ground-inverse" id="evening" style="--h: 2" data-moment="pinned-chapters" aria-labelledby="evening-h">
      <div class="wrap mo-pc__grid">
        <div class="mo-pc__text">
          <h2 id="evening-h">每個晚上的流程</h2>
          <ol class="mo-pc__steps">
            {
              evening.map((e) => (
                <li class="mo-pc__step">
                  <h3>{e.title}</h3>
                  <p>{e.desc}</p>
                  <figure class="mo-pc__visual">
                    <img src={img(`${e.img}-1536.jpg`)} srcset={srcset(e.img, [768, 1536])} sizes="(max-width: 1023px) 100vw, 50vw" alt={e.alt} width="1536" height="1024" decoding="async" data-source="client" data-subject="scene" />
                  </figure>
                </li>
              ))
            }
          </ol>
        </div>
        <div class="mo-pc__visuals frame"></div>
      </div>
    </section>

    <section class="section" id="faq" aria-labelledby="faq-h">
      <div class="wrap">
        <div class="grid">
          <div class="span-5 stack-5">
            <div class="stack-4">
              <h2 id="faq-h">常見問題</h2>
              <p class="muted">還有其他問題，課堂上或課後都可以直接問帶領者。</p>
            </div>
            <figure class="frame frame--photo frame--land" data-moment="picture-develops">
              <img
                class="frame__img"
                src={img('ai-faq-1280.jpg')}
                srcset={srcset('ai-faq', [1280, 1774])}
                sizes="(max-width: 639px) 1068px, (max-width: 1023px) 100vw, 780px"
                width="1774"
                height="887"
                alt="雙手捧著一杯熱茶，窗外是黃昏的台北"
                loading="lazy"
                decoding="async"
                data-source="client"
                data-subject="scene"
              />
            </figure>
          </div>
          <div class="faq span-6 start-7">
            {
              faqs.map((f) => (
                <div class="faq__item">
                  <h3>{f.q}</h3>
                  <p>{f.a}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer closing" id="contact" aria-labelledby="close-h">
    <div class="wrap">
      <div class="closing__cta close--type">
        <ul class="keywords" aria-label="五堂課會練習的事">{keywords.map((k) => <li>{k}</li>)}</ul>
        <div class="section-head">
          <h2 id="close-h">一個人也很好，<wbr />兩個人可以更好。</h2>
          <p class="t-small muted">五個晚上，每晚 18:45 到 21:15，含晚餐。</p>
        </div>
        <a class="btn btn--primary btn--xl btn--wide" href="#sessions">{mainAction}<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"></path><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"></path></svg></a>
      </div>
      <div class="closing__links">
        <div class="grid">
          <div class="span-4 stack-4">
            <a class="nav__logo" href="#top"><span class="mark" data-mark="arc" aria-hidden="true"></span>關係練習室</a>
            <p class="footer__lede">在晚餐桌上練習愛的五堂課</p>
          </div>
          <div class="span-2 footer__col"><h3>擔心</h3><ul><li><a href="#worries">四個擔心</a></li><li><a href={url('sources/')}>資料來源</a></li></ul></div>
          <div class="span-2 footer__col"><h3>五堂課</h3><ul>{sessions.map((s) => <li><a href={url(`sessions/${s.num}/`)}>{s.title}</a></li>)}</ul></div>
          <div class="span-2 footer__col"><h3>流程</h3><ul><li><a href="#evening">每晚流程</a></li><li><a href={url('timer/')}>帶領者計時器</a></li></ul></div>
          <div class="span-2 footer__col"><h3>問答</h3><ul><li><a href="#faq">常見問題</a></li></ul></div>
        </div>
        <div class="footer__legal">
          <span>&copy; 2026 關係練習室</span>
          <div class="socials"></div>
          <span class="credits">照片皆為 AI 生成的示意圖</span>
        </div>
      </div>
    </div>
  </footer>

  <script is:inline type="module">
    // 「四個擔心」的小圖：捲到時畫一次；減少動態效果、或瀏覽器不支援時直接顯示完成圖
    const charts = document.querySelectorAll('.wchart');
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
      charts.forEach((c) => c.classList.add('wc-wait'));
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.classList.remove('wc-wait');
          io.unobserve(e.target);
        });
      }, { threshold: 0.4 });
      charts.forEach((c) => io.observe(c));
    }
  </script>
</Landing>
