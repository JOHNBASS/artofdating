---
// 首頁：一進來先選版本（課程版／劇本殺版）
import Base from '../layouts/Base.astro';
import NextEvent from '../components/NextEvent.astro';
import { upcomingEvents, eventStart, eventEnd } from '../data/events.js';
import { absUrl } from '../data/site.js';
import { classHours, schedule } from '../data/sessions.js';
import { mystery, mysteryHours } from '../data/mystery.js';
import { url } from '../scripts/paths.js';

const img = (name: string, w: number) => url(`assets/img/${name}-${w}.jpg`);
const { meal } = schedule;
const mh = mysteryHours();

// 給 Google 看的活動資料（schema.org Event），有機會出現在 Google 搜尋的活動區塊
const eventLd = upcomingEvents().map((e) => ({
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: e.title,
  description: e.summary,
  startDate: eventStart(e),
  endDate: eventEnd(e),
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: {
    '@type': 'Place',
    name: e.venue || e.city,
    address: { '@type': 'PostalAddress', addressLocality: e.city, addressCountry: 'TW' },
  },
  image: [absUrl(e.session ? `og/s${e.session}.jpg` : 'share.jpg')],
  organizer: { '@type': 'Organization', name: '關係練習室', url: absUrl('') },
  offers: { '@type': 'Offer', url: e.signup, availability: 'https://schema.org/InStock' },
}));

const versions = [
  {
    href: url('course/'),
    kind: '課程版',
    title: '五堂關係課',
    text: `五次聚會，每次 ${classHours.start} 到 ${classHours.end}${meal ? `，含${meal}` : ''}。用短講和練習，學會聆聽、吵架、選擇、靠近與冒險。`,
    facts: ['5 堂課', '每堂 2.5 小時', '同桌 4–6 人'],
    photo: 'ai-e2-practice',
    alt: '兩個人在燭光小桌兩側對坐，一人拿著一張題目卡',
    cta: '進入課程版',
  },
  {
    href: url('mystery/'),
    kind: '劇本殺版',
    title: `《${mystery.title}》`,
    text: `一場 ${mh.start} 到 ${mh.end} 的情感推理。六個人回到快收掉的咖啡館，打開十年前的時光膠囊。沒有命案，要解開的是人心。`,
    facts: ['1 場', '2.5 小時', '6 人（3 男 3 女）'],
    photo: 'ai-e3-home',
    alt: '一隻手把摺好的小卡片放進大衣口袋',
    cta: '進入劇本殺版',
  },
];
---

<Base title="選擇版本" description="關係練習室：給單身者的關係課。可以選五堂課的課程版，或一場 2.5 小時的劇本殺版。">
  {eventLd.length > 0 && <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(eventLd)} />}
  <section class="wrap-wide choose">
    <p class="eyebrow">關係練習室</p>
    <h1>你想怎麼開始？</h1>
    <p class="lead">兩種方式都以關係研究為基礎，單身來就好，情侶也歡迎，都不配對。</p>

    <div class="versions">
      {
        versions.map((v) => (
          <a class="version" href={v.href}>
            <figure>
              <img
                src={img(v.photo, 768)}
                srcset={`${img(v.photo, 768)} 768w, ${img(v.photo, 1536)} 1536w`}
                sizes="(max-width: 759px) 100vw, 50vw"
                width="1536"
                height="1024"
                alt={v.alt}
                loading="eager"
                decoding="async"
              />
            </figure>
            <div class="text">
              <p class="kind">{v.kind}</p>
              <h2>{v.title}</h2>
              <p>{v.text}</p>
              <ul class="facts">
                {v.facts.map((f) => (
                  <li>{f}</li>
                ))}
              </ul>
              <span class="go">
                {v.cta}
                <span aria-hidden="true">→</span>
              </span>
            </div>
          </a>
        ))
      }
    </div>
    <p class="muted small note">照片皆為 AI 生成的示意圖。</p>
  </section>

  <section class="wrap-wide more" id="events">
    <h2 class="sec">近期場次</h2>
    <NextEvent heading="報名中" from="home" all />
  </section>

  <section class="wrap-wide more">
    <h2 class="sec">免費小工具</h2>
    <div class="tools">
      <a class="tool" href={url('quiz/')}>
        <p class="kind">1 分鐘小測驗</p>
        <h3>你是哪一種聆聽者？</h3>
        <p class="muted">修理師、同路人、小太陽、分析師，你是哪一種？測完有一張可以分享的結果卡。</p>
        <span class="link">開始測驗 <span aria-hidden="true">→</span></span>
      </a>
      <a class="tool" href={url('questions/')}>
        <p class="kind">約會、聊天都用得到</p>
        <h3>好問題抽卡</h3>
        <p class="muted">從輕鬆到深入的 30 個好問題，一次抽一張，問完記得追問「然後呢？」</p>
        <span class="link">抽一張 <span aria-hidden="true">→</span></span>
      </a>
    </div>
  </section>

  <section class="wrap-wide more">
    <div class="join">
      <h2 class="sec">一起來做這件事</h2>
      <p>如果你也希望為這個世代的關係議題做些什麼，想一起辦活動、提供場地，或只是想聊聊，都歡迎留言給我。</p>
      <a class="btn" href={url('contact/')}>留言給我 <span aria-hidden="true">→</span></a>
    </div>
  </section>
</Base>

<style>
  .choose {
    padding-top: 2.2em;
    padding-bottom: 1em;
  }
  .eyebrow {
    color: var(--accent);
    font-weight: 700;
    letter-spacing: 0.12em;
    margin: 0;
  }
  h1 {
    margin: 0.15em 0 0.25em;
  }
  .lead {
    color: var(--ink-soft);
    font-size: 1.08rem;
    max-width: 34em;
  }
  .versions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin-top: 1.6em;
  }
  .version {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    color: var(--ink);
    text-decoration: none;
    box-shadow: var(--shadow);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .version:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .version:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }
  figure {
    margin: 0;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--surface-2);
  }
  figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  .version:hover figure img {
    transform: scale(1.03);
  }
  .text {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 18px 20px 20px;
  }
  .kind {
    color: var(--accent);
    font-weight: 700;
    font-size: 0.88rem;
    letter-spacing: 0.1em;
    margin: 0;
  }
  h2 {
    margin: 0.1em 0 0.4em;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    padding: 0;
    margin: 0 0 1.2em;
  }
  .facts li {
    margin: 0;
    font-size: 0.85rem;
    padding: 0.15em 0.7em;
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--ink-soft);
  }
  .go {
    margin-top: auto;
    align-self: flex-start;
    display: inline-flex;
    gap: 0.5em;
    align-items: center;
    min-height: 44px;
    padding: 0.55em 1.2em;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-weight: 500;
  }
  :global(:root[data-theme='dark']) .go {
    color: #1b1416;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .go {
      color: #1b1416;
    }
  }
  .note {
    margin-top: 1.4em;
  }
  .more {
    margin-top: 2.6em;
  }
  h2.sec {
    margin: 0 0 0.6em;
  }
  .tools {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .tool {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 18px 20px 20px;
    color: var(--ink);
    text-decoration: none;
    box-shadow: var(--shadow);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .tool:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .tool:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }
  .tool h3 {
    margin: 0.1em 0 0.3em;
  }
  .tool .link {
    margin-top: auto;
    color: var(--accent);
    font-weight: 500;
  }
  .join {
    background: var(--surface-2);
    border-radius: var(--radius);
    padding: 22px 22px 24px;
  }
  .join p {
    max-width: 36em;
  }
  @media (max-width: 759px) {
    .versions,
    .tools {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .version,
    .tool,
    figure img {
      transition: none;
    }
    .version:hover,
    .tool:hover,
    .version:hover figure img {
      transform: none;
    }
  }
</style>
