---
import Landing from '../layouts/Landing.astro';
import { sessions } from '../data/sessions.js';
import { worries } from '../data/worries.js';
import WorryChart from '../components/WorryChart.astro';
import { url } from '../scripts/paths.js';

const img = (f: string) => url(`assets/img/${f}`);
const mainAction = '看五堂課';

// word-highlight 以空白切字；中文沒有空白，所以先把句子切成詞組，每組一個 span
const statement: (string | { strong: string })[] = [
  '愛情', '不會因為', '結婚', '就死掉；', '讓它', '慢慢消失的，', '是', '兩個人', '不再', '一起練習。',
  '好好聆聽、', '好好吵架、', '好好做決定，', '這些', '都', { strong: '學得會' }, '。',
];

const evening = [
  { time: '18:45', title: '入場與破冰', desc: '找到你的桌組，從一個輕鬆的小遊戲開始。' },
  { time: '19:00', title: '一起晚餐', desc: '同桌 4 到 6 人，五週都坐同一桌。' },
  { time: '19:30', title: '三段主題', desc: '每段一個短講，接著一個練習。' },
  { time: '21:00', title: '本週約會實驗', desc: '帶一個小任務回家，在生活裡試試看。' },
  { time: '21:15', title: '結束', desc: '想多聊可以留下，想早點回家也沒問題。' },
];

// 桌機每題答案一行；more 是手機上多顯示的一句，讓常見問題剛好兩屏
const faqs = [
  { q: '我是單身，會不會很尷尬？', a: '不會。課程以單身者為主，練習可以自己做，或和當晚的夥伴一起做。', more: '不需要帶伴侶來。' },
  { q: '這是聯誼嗎？', a: '不是。我們不配對，也不安排約會；但你會認識一群認真看待關係的人。' },
  { q: '一定要分享自己的隱私嗎？', a: '不用。私密的題目只自己寫，任何問題都可以說 pass。', more: '每個練習都標明是自己寫、兩人聊，還是同桌聊。' },
  { q: '這是宗教課程嗎？', a: '不是。創辦人是基督徒，想聊信仰可以私下聊；課程以關係研究為基礎，不傳教。', more: '不需要任何信仰背景。' },
  { q: '我已經在交往了，可以兩人一起來嗎？', a: '歡迎。兩人一起來時，「兩人」的練習就由你們彼此一組。' },
  { q: '我在網站上寫的內容，別人看得到嗎？', a: '看不到。內容只存在你自己的瀏覽器裡，不會上傳，也可以隨時清除。', more: '想留著的話，可以傳給自己保存。' },
  { q: '需要準備什麼？', a: '一支手機，用來打開這個網站做練習；或帶一支筆也可以。', phone: true },
];
---

<Landing
  title="關係練習室：給單身者的五晚關係課"
  description="五個晚上，一起吃晚餐，用關係研究和練習學會聆聽、吵架、做選擇和靠近。以單身者為主，情侶也歡迎。"
  moments={['word-highlight', 'picture-develops']}
>
  <style is:inline slot="head">
    /* 頁面 CSS：只放視覺內部與套件沒有的部分 */
    .frame--square { aspect-ratio: 8 / 9; }
    .frame--land { aspect-ratio: 4 / 3; }
    .frame--square > img, .frame--land > img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .develop { margin: 0; border-radius: var(--r-lg); overflow: hidden; height: min(708px, var(--ly-fit, 708px)); }
    .develop > img { display: block; width: 100%; height: 100%; object-fit: cover; }
    @media (max-width: 1023px) { .develop { height: auto; aspect-ratio: 4 / 3; margin-top: var(--s-7); } }
    #worries .section-head { align-self: start; }
    .worry { display: flex; flex-direction: column; gap: var(--s-2); }
    .worry h3 { margin: 0; }
    .worry .stat { margin-top: var(--s-2); }
    .worry .stat .t-stat { margin-right: var(--s-1); }
    .worry p { margin: 0; }
    .worry .src { margin-top: auto; padding-top: var(--s-2); }
    .wchart { display: block; width: 100%; height: auto; margin-top: var(--s-3); overflow: visible; }
    .wchart text { font: 500 15px var(--font-text); fill: var(--muted); }
    .wchart .axis { stroke: var(--line, rgba(43,32,36,.15)); stroke-width: 1.5; }
    .wchart .line { fill: none; stroke: var(--ink); stroke-width: 3; stroke-linecap: round; }
    .wchart .mark { fill: var(--accent); }
    .wchart .dot, .wchart .track { fill: rgba(43, 32, 36, .12); }
    /* 1024 以上四張並排；平板兩欄（照片收起來）；手機一欄 */
    @media (min-width: 1024px) and (max-width: 1279px) { .worry .src { display: none; } }
    @media (min-width: 640px) and (max-width: 1023px) { .worries > .span-3 { grid-column: span 6; } #worries .frame, .worry .src { display: none; } .develop { aspect-ratio: 1 / 1; } }
    /* 手機：四張卡片要在兩屏內，照片和出處收起來（出處在資料來源頁），小圖壓低 */
    @media (max-width: 639px) { .worries > .span-3 { grid-column: 1 / -1; } #worries .frame, .worry .src { display: none; } .wchart { height: 80px; } .wchart text { display: none; } #worries .t-lead { display: none; } #faq .frame { aspect-ratio: 16 / 25; } #faq .frame img { object-position: 35% 55%; } }
    @media (min-width: 640px) { #faq .phone-only { display: none; } }
    .rows__name small { display: block; font-weight: 400; color: var(--muted); font-size: var(--t-small); }
    /* 中文標題只在詞組之間換行（<wbr>），不會斷在詞的中間 */
    #hero-h, #close-h { word-break: keep-all; }
    /* 平板直立時，課程列表和流程疊成一欄，各給兩個螢幕高 */
    @media (min-width: 640px) and (max-width: 1023px) { #sessions, #evening, #faq { --h: 2 } }
  </style>

  <!-- type: service（五晚的關係工作坊，主辦是個人）
       deal: hero photo (data-calm left, 字在色塊裡), nav nav-centre, close close-type, footer footer-columns,
             rhythm dark-band (#evening), buttons tonal, mark arc, palette brand（課程頁原本的米白與酒紅）, type newsreader + Noto TC
       moments: word-highlight in #statement, picture-develops in #evening
       照片：全部是 Wikimedia Commons 的替代照片，之後換成課程現場照（見 README） -->
  <header class="nav nav--centre">
    <div class="wrap nav__bar">
      <a class="skip-link" href="#top">跳到主要內容</a>
      <a class="nav__logo" href="#top"><span class="mark" data-mark="arc" aria-hidden="true"></span>關係練習室</a>
      <nav class="nav__links" aria-label="主選單">
        <div class="nav__item"><a class="nav__link" href="#worries">擔心</a></div>
        <div class="nav__item">
          <a class="nav__link" href="#sessions">五堂課 <svg class="chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></a>
          <div class="nav__menu">
            <div class="wrap grid">
              <div class="menu-col span-4">
                <p class="t-label">課程內容</p>
                {sessions.slice(0, 3).map((s) => (
                  <a href={url(`sessions/${s.num}/`)}>第 {s.num} 堂・{s.title}<span>{s.tagline}</span></a>
                ))}
              </div>
              <div class="menu-col span-4">
                <p class="t-label">&nbsp;</p>
                {sessions.slice(3).map((s) => (
                  <a href={url(`sessions/${s.num}/`)}>第 {s.num} 堂・{s.title}<span>{s.tagline}</span></a>
                ))}
              </div>
            </div>
          </div>
        </div>
        <div class="nav__item"><a class="nav__link" href="#evening">流程</a></div>
        <div class="nav__item"><a class="nav__link" href="#faq">問答</a></div>
      </nav>
      <div class="nav__actions">
        <a class="btn btn--primary" href="#sessions">{mainAction}</a>
      </div>
      <button class="nav__toggle" type="button" aria-expanded="false" aria-label="選單">
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 5h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
      </button>
    </div>
  </header>

  <main id="top">
    <section class="hero hero--photo" data-enter data-calm="left" aria-labelledby="hero-h">
      <img
        class="hero__bg"
        src={img('photo-f22545674-1280.jpg')}
        srcset={`${img('photo-f22545674-960.jpg')} 960w, ${img('photo-f22545674-1280.jpg')} 1280w, ${img('photo-f22545674-1920.jpg')} 1920w`}
        sizes="(max-width: 639px) 189vw, 100vw"
        width="1920"
        height="1270"
        alt="燭光下鋪好白桌巾的長餐桌，杯盤已經擺好"
        style="--ly-pos: 62% 70%; --ly-pos-phone: 46% 72%"
        fetchpriority="high"
        decoding="async"
        data-source="stand-in"
        data-subject="stand-in"
      />
      <div class="wrap"><div class="hero-text">
        <div class="hero__text">
          <h1 id="hero-h">給單身的<wbr />五晚<wbr />關係課</h1>
          <p class="hero__lead">五個晚上，每晚 18:45 到 21:15。先一起吃晚餐，再用練習學會聆聽、吵架、做選擇和靠近。內容以關係研究為基礎，單身來就好，情侶也歡迎。</p>
          <div class="btn-row">
            <a class="btn btn--primary" href="#sessions">{mainAction}<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"></path><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"></path></svg></a>
            <a class="btn btn--secondary" href={url('sessions/1/')}>開始第一堂</a>
          </div>
        </div>
      </div></div>
    </section>

    <section class="section g2" id="worries" aria-labelledby="worries-h">
      <div class="wrap">
        <div class="group">
          <div class="grid">
            <div class="section-head span-5">
              <h2 id="worries-h">關於愛情的四個擔心。<span class="muted">先看數字，再談能做什麼。</span></h2>
              <p class="t-lead">怕受傷、怕失去自由、怕看錯人，這些擔心都很真實。我們把最常聽到的四個整理出來，附上可以查證的資料。</p>
              <p><a class="link" href={url('sources/')}>看完整資料來源</a></p>
            </div>
            <div class="frame frame--photo frame--land span-6 start-7">
              <img
                class="frame__img"
                src={img('photo-d183.jpg')}
                srcset={`${img('photo-d183-500.jpg')} 500w, ${img('photo-d183-960.jpg')} 960w, ${img('photo-d183.jpg')} 1280w`}
                sizes="(max-width: 1023px) 100vw, 50vw"
                width="1280"
                height="853"
                alt="深色木桌上一本打開的空白筆記本，一支鉛筆橫放在頁面上"
                loading="lazy"
                decoding="async"
                data-source="library"
                data-subject="stand-in"
              />
            </div>
          </div>
        </div>
        <div class="grid worries">
          {
            worries.map((w) => (
              <article class="card worry m-nolift span-3">
                <h3>{w.q}</h3>
                <WorryChart chart={w.chart} />
                <p class="stat"><span class="t-stat">{w.stat}</span> <span class="t-small muted">{w.statLabel}</span></p>
                <p>{w.a}</p>
                <p class="t-small muted src">資料：{w.src}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section statement" id="statement" data-moment="word-highlight" aria-label="我們相信的事">
      <div class="wrap">
        <p class="t-label">我們相信的事</p>
        <p class="mo-wh__text">
          {statement.map((w) => (typeof w === 'string' ? <span>{w}</span> : <strong><span>{w.strong}</span></strong>))}
        </p>
      </div>
    </section>

    <section class="section" id="sessions" aria-labelledby="sessions-h">
      <div class="wrap">
        <div class="grid">
          <div class="span-5 stack-5">
            <div class="section-head">
              <h2 id="sessions-h">五個晚上的五堂課</h2>
              <p>每堂有短講、練習，和一個帶回家的約會實驗。點進去就是當晚的上課內容和互動練習。</p>
            </div>
            <ul class="rows">
              {
                sessions.map((s) => (
                  <li>
                    <span class="rows__name">
                      <a class="link" href={url(`sessions/${s.num}/`)}>第 {s.num} 堂・{s.title}</a>
                      <small>{s.tagline}</small>
                    </span>
                    <span class="rows__value">{s.theme}</span>
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="frame frame--photo frame--square span-6 start-7">
            <img
              class="frame__img"
              src={img('photo-f187328837-1000.jpg')}
              srcset={`${img('photo-f187328837-500.jpg')} 500w, ${img('photo-f187328837-1000.jpg')} 1000w`}
              sizes="(max-width: 1023px) 100vw, 50vw"
              width="1000"
              height="1493"
              alt="木頭長桌上，一個人把咖啡倒進兩個小杯子"
              loading="lazy"
              decoding="async"
              data-source="stand-in"
              data-subject="stand-in"
            />
          </div>
        </div>
      </div>
    </section>

    <section class="section ground-inverse" id="evening" aria-labelledby="evening-h">
      <div class="wrap">
        <div class="grid">
          <div class="span-5 stack-5">
            <div class="section-head">
              <h2 id="evening-h">每個晚上的流程</h2>
              <p>每個練習都標明是自己寫、兩人聊，還是同桌一起聊。任何問題，你都可以說 pass。</p>
            </div>
            <ul class="rows">
              {
                evening.map((e) => (
                  <li>
                    <span class="rows__name">
                      {e.title}
                      <small>{e.desc}</small>
                    </span>
                    <span class="rows__value">{e.time}</span>
                  </li>
                ))
              }
            </ul>
          </div>
          <figure class="develop span-6 start-7" data-moment="picture-develops">
            <img
              src={img('photo-f28663652-1000.jpg')}
              srcset={`${img('photo-f28663652-500.jpg')} 500w, ${img('photo-f28663652-1000.jpg')} 1000w`}
              sizes="(max-width: 1023px) 100vw, 50vw"
              width="1000"
              height="1520"
              alt="燭台下擺好的餐盤、餐巾和酒杯"
              loading="lazy"
              decoding="async"
              data-source="stand-in"
              data-subject="stand-in"
            />
          </figure>
        </div>
      </div>
    </section>

    <section class="section" id="faq" style="--hm: 2" aria-labelledby="faq-h">
      <div class="wrap">
        <div class="grid">
          <div class="span-5 stack-5">
            <div class="stack-4">
              <h2 id="faq-h">常見問題</h2>
              <p class="muted">還有其他問題，課堂上或課後都可以直接問帶領者。</p>
            </div>
            <div class="frame frame--photo frame--land">
              <img
                class="frame__img"
                src={img('photo-c141.jpg')}
                srcset={`${img('photo-c141-500.jpg')} 500w, ${img('photo-c141-960.jpg')} 960w, ${img('photo-c141.jpg')} 1280w`}
                sizes="(max-width: 639px) 200vw, (max-width: 1023px) 100vw, 40vw"
                width="1280"
                height="853"
                alt="雙手捧著一杯熱拿鐵，牛奶正從小鋼杯倒進杯裡"
                loading="lazy"
                decoding="async"
                data-source="library"
                data-subject="stand-in"
              />
            </div>
          </div>
          <div class="faq span-6 start-7">
            {
              faqs.map((f) => (
                <div class={f.phone ? 'faq__item phone-only' : 'faq__item'}>
                  <h3>{f.q}</h3>
                  <p>{f.a}{f.more && <span class="phone-only"> {f.more}</span>}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer closing" id="contact" aria-labelledby="close-h">
    <div class="wrap">
      <div class="closing__cta close--type">
        <div class="section-head">
          <h2 id="close-h">一個人也很好，<wbr />兩個人可以更好。</h2>
          <p class="t-small muted">五個晚上，每晚 18:45 到 21:15，含晚餐。</p>
        </div>
        <a class="btn btn--primary btn--xl" href="#sessions">{mainAction}<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"></path><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"></path></svg></a>
      </div>
      <div class="closing__links">
        <div class="grid">
          <div class="span-4 stack-4">
            <a class="nav__logo" href="#top"><span class="mark" data-mark="arc" aria-hidden="true"></span>關係練習室</a>
            <p class="footer__lede">在晚餐桌上練習愛的五堂課</p>
          </div>
          <div class="span-2 footer__col"><h3>擔心</h3><ul><li><a href="#worries">四個擔心</a></li><li><a href={url('sources/')}>資料來源</a></li></ul></div>
          <div class="span-2 footer__col"><h3>五堂課</h3><ul>{sessions.map((s) => <li><a href={url(`sessions/${s.num}/`)}>{s.title}</a></li>)}</ul></div>
          <div class="span-2 footer__col"><h3>流程</h3><ul><li><a href="#evening">每晚流程</a></li><li><a href={url('timer/')}>帶領者計時器</a></li></ul></div>
          <div class="span-2 footer__col"><h3>問答</h3><ul><li><a href="#faq">常見問題</a></li></ul></div>
        </div>
        <div class="footer__legal">
          <span>&copy; 2026 關係練習室</span>
          <div class="socials"></div>
          <a class="credits" href={url('credits.html')}>Photographs via Wikimedia Commons</a>
        </div>
      </div>
    </div>
  </footer>
</Landing>
