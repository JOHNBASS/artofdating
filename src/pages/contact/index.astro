---
// 留言給我：收信信箱和 Web3Forms 金鑰寫在 src/data/site.js
import Base from '../../layouts/Base.astro';
import NextEvent from '../../components/NextEvent.astro';
import { siteConfig } from '../../data/site.js';

const { user, domain, web3formsKey } = siteConfig.contact;
const interests = ['參加活動', '一起辦活動', '提供場地或合作', '給內容回饋', '其他'];
---

<Base
  title="留言給我"
  description="想參加活動、想一起辦，或只是想說說話，都歡迎留言。也邀請關心這個世代關係議題的你，一起加入討論。"
  image="og/contact.jpg"
>
  <div class="wrap contact" data-contact={JSON.stringify({ user, domain, key: web3formsKey })}>
    <p class="eyebrow">關係練習室</p>
    <h1>留言給我</h1>
    <p class="lead">想參加活動、對內容有回饋、想一起辦，或只是想說說話，都可以寫在這裡。每一則留言我都會親自讀。</p>

    <section class="join">
      <h2>一起來做這件事</h2>
      <p>只要你對這件事有興趣，或也希望為這個世代的關係議題做些什麼，就很歡迎認識彼此。</p>
      <p>想邀請有相同想法、熱情或負擔的你，一起加入討論。</p>
      <p>也許我們可以從一次聊天、一場腦力激盪開始，讓一些原本只是想法的事情，慢慢成為真正能幫助別人的行動。</p>
      <p class="muted">例如：一起主持或當助教、提供場地、分享你的專業（心理、諮商、戲劇、設計、攝影），或介紹朋友來參加。</p>
    </section>

    <form class="form" data-form novalidate>
      <label>
        <span>怎麼稱呼你 <em>必填</em></span>
        <input type="text" name="name" autocomplete="name" required maxlength="60" />
      </label>
      <label>
        <span>Email 或 LINE ID</span>
        <input type="text" name="contact" autocomplete="email" maxlength="120" placeholder="想要我回覆的話，請留一個" />
      </label>
      <fieldset>
        <legend>我想⋯⋯（可以複選）</legend>
        <div class="chips">
          {
            interests.map((x) => (
              <label class="chip">
                <input type="checkbox" name="interest" value={x} />
                <span>{x}</span>
              </label>
            ))
          }
        </div>
      </fieldset>
      <label>
        <span>想說的話 <em>必填</em></span>
        <textarea name="message" rows="6" required maxlength="3000"></textarea>
      </label>
      <!-- 防垃圾留言：真人看不到這一格 -->
      <input type="checkbox" name="botcheck" class="trap" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <div class="row">
        <button type="submit" class="btn-primary" data-submit>送出</button>
        <span class="muted small" data-how></span>
      </div>
      <p class="status" data-status role="status" hidden></p>
      <p class="muted small">你的留言只會寄到我的信箱，不會公開在網站上。</p>
    </form>

    <p class="direct muted small">
      也可以直接寄信到 <a data-mail href="#">（需要開啟 JavaScript 才看得到信箱）</a>
      <button type="button" class="copy" data-copy-mail hidden>複製信箱</button>
    </p>

    <NextEvent heading="近期場次" from="contact" all />
  </div>
</Base>

<script>
  import { track } from '../../scripts/track.js';
  import { copyText } from '../../scripts/share-image.js';

  const root = document.querySelector<HTMLElement>('[data-contact]')!;
  const { user, domain, key } = JSON.parse(root.dataset.contact!);
  const email = `${user}@${domain}`;
  const form = root.querySelector<HTMLFormElement>('[data-form]')!;
  const status = root.querySelector<HTMLElement>('[data-status]')!;
  const submit = root.querySelector<HTMLButtonElement>('[data-submit]')!;

  // 直接寄信的連結（網頁原始碼裡沒有完整信箱）
  const mail = root.querySelector<HTMLAnchorElement>('[data-mail]')!;
  mail.href = `mailto:${email}`;
  mail.textContent = email;
  const copyMail = root.querySelector<HTMLButtonElement>('[data-copy-mail]')!;
  copyMail.hidden = false;
  copyMail.addEventListener('click', async () => {
    copyMail.textContent = (await copyText(email)) ? '已複製' : email;
  });

  root.querySelector<HTMLElement>('[data-how]')!.textContent = key ? '' : '按下送出會打開你的 Email App，內容已經幫你填好。';

  const say = (msg: string, ok = true) => {
    status.textContent = msg;
    status.classList.toggle('bad', !ok);
    status.hidden = false;
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    if (fd.get('botcheck')) return;
    const name = String(fd.get('name') || '').trim();
    const contact = String(fd.get('contact') || '').trim();
    const message = String(fd.get('message') || '').trim();
    const picked = fd.getAll('interest').map(String);
    if (!name || !message) {
      say('請填寫「怎麼稱呼你」和「想說的話」。', false);
      (form.elements.namedItem(name ? 'message' : 'name') as HTMLElement).focus();
      return;
    }
    const subject = `[關係練習室] ${name} 的留言${picked.length ? `（${picked.join('、')}）` : ''}`;
    const body = [`稱呼：${name}`, `聯絡方式：${contact || '（沒有留）'}`, `我想：${picked.join('、') || '（沒有勾）'}`, '', message].join('\n');

    if (!key) {
      // 沒有設定 Web3Forms：打開訪客自己的 Email App
      track('contact_submit', { method: 'mailto' });
      location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      say(`如果沒有自動打開 Email App，也可以把內容複製起來，寄到 ${email}。`);
      return;
    }

    submit.disabled = true;
    submit.textContent = '送出中⋯⋯';
    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          access_key: key,
          subject,
          from_name: '關係練習室網站',
          ...(contact.includes('@') ? { replyto: contact } : {}),
          稱呼: name,
          聯絡方式: contact || '（沒有留）',
          我想: picked.join('、') || '（沒有勾）',
          留言: message,
        }),
      });
      const json = await res.json().catch(() => ({}));
      if (!res.ok || !json.success) throw new Error(json.message || res.statusText);
      track('contact_submit', { method: 'form' });
      form.reset();
      say('收到了，謝謝你！我讀完會盡快回覆你。');
    } catch {
      say(`送出失敗了，可以稍後再試，或直接寄信到 ${email}。`, false);
    } finally {
      submit.disabled = false;
      submit.textContent = '送出';
    }
  });
</script>

<style>
  .contact {
    padding-top: 2.2em;
  }
  .eyebrow {
    color: var(--accent);
    font-weight: 700;
    letter-spacing: 0.1em;
    margin: 0;
  }
  h1 {
    margin: 0.15em 0 0.3em;
  }
  .lead {
    color: var(--ink-soft);
    font-size: 1.08rem;
  }
  .join {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 4px 22px 10px;
    margin: 1.6em 0;
  }
  .join h2 {
    margin-top: 0.8em;
  }
  .form {
    display: grid;
    gap: 16px;
    margin: 1.6em 0 1em;
  }
  .form label > span,
  legend {
    display: block;
    font-weight: 500;
    margin-bottom: 6px;
  }
  .form em {
    font-style: normal;
    font-size: 0.8rem;
    color: var(--accent);
    margin-left: 4px;
  }
  fieldset {
    border: 0;
    padding: 0;
    margin: 0;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chip {
    position: relative;
  }
  .chip input {
    position: absolute;
    opacity: 0;
    inset: 0;
    cursor: pointer;
  }
  .chip span {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0.3em 0.95em;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    margin: 0 !important;
    font-weight: 400 !important;
  }
  .chip input:checked + span {
    background: var(--accent-soft);
    border-color: var(--accent);
    color: var(--accent);
    font-weight: 700 !important;
  }
  .chip input:focus-visible + span {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .trap {
    position: absolute;
    left: -9999px;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }
  .status {
    margin: 0;
    padding: 12px 16px;
    border-radius: 12px;
    background: var(--table-soft);
    color: var(--table);
  }
  .status.bad {
    background: var(--accent-soft);
    color: var(--accent);
  }
  .direct {
    margin-bottom: 2em;
  }
  .copy {
    min-height: 34px;
    padding: 0.2em 0.8em;
    font-size: 0.85rem;
    margin-left: 6px;
  }
</style>
